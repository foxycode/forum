parameters:

application:
    errorPresenter:
        4xx: Error4xx
        5xx: Error5xx
    mapping: App\*Module\Presenters\*Presenter

session:
    expiration: 1 year

services:
    - App\Core\RouterFactory::createRouter
    - App\Core\UserManager

search:
    - in: %appDir%/Forms
      classes:
          - *Factory
    - in: %appDir%/Model/Repositories
